# --- Core ---
PORT=8039
DATABASE_URL=postgres://user:pass@localhost:5432/characterbuilder
# SKIP_DB_INIT=1          # skip CREATE TABLE on boot (schema already applied)
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:5145   # CORS origin
# CORS_ORIGINS=https://app.example.com,https://other.example.com

# --- Auth (Firebase) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SITEADMIN_EMAILS=
# AUTH_TEST_MODE=1        # accept `Bearer dev:<uid>:<email>` tokens (dev only)

# --- Image generation (ShapeShyft) ---
SHAPESHYFT_ENDPOINT_URL=https://api.shapeshyft.ai/api/v1/ai/<org>/<project>
SHAPESHYFT_API_KEY=sk_live_...
SHAPESHYFT_IMAGE_ENDPOINT=character-image
SHAPESHYFT_TIMEOUT_MS=240000

# --- Storage ---
STORAGE_DRIVER=local       # memory | local
STORAGE_DIR=./.storage

# --- Credits / RevenueCat ---
# Free credits granted on a new account's first balance read.
INITIAL_FREE_CREDITS=20
# Priced catalog: `productId:credits` pairs, comma-separated. Credit grants are
# server-owned; the product ids must match the RevenueCat offering's packages.
CREDIT_PRODUCTS=cb_credits_100:100,cb_credits_500:500
# Shared bearer secret guarding POST /api/v1/consumables/webhook (RevenueCat).
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat REST *secret* API key. Used by POST /api/v1/consumables/purchase to
# verify a transaction against RevenueCat before crediting. Required only when
# confirming purchases server-side.
REVENUECAT_SECRET_API_KEY=
